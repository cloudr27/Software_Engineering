# ==========================================
# Python / UV (для папки backend)
# ==========================================
# Виртуальное окружение (содержит библиотеки, его нельзя коммитить)
.venv/
venv/
env/

# Кэш Python (создается автоматически при запуске)
__pycache__/
*.py[cod]
*$py.class

# Переменные окружения (там лежат пароли от БД)
.env
.env.*
!.env.example

# Базы данных SQLite (если вдруг появятся)
*.sqlite3

# ==========================================
# Node.js / React (для папки frontend, на будущее)
# ==========================================
node_modules/
dist/
build/
npm-debug.log*
yarn-debug.log*
yarn-error.log*

# ==========================================
# Настройки редакторов и ОС
# ==========================================
# VS Code (папка с локальными настройками)
.vscode/
# macOS (если кто-то из команды на Mac)
.DS_Store
# Windows
Thumbs.db